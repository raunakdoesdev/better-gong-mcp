{
  "name": "gong-calls",
  "main": "src/index.ts",
  "account_id": "<cloudflare-account-id>",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "calls.example.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "gong-calls", "database_id": "<d1-database-id>" }
  ],
  "vectorize": [{ "binding": "VECTORS", "index_name": "gong-calls" }],
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [{ "binding": "SYNC", "queue": "gong-calls-sync" }],
    "consumers": [{ "queue": "gong-calls-sync", "max_batch_size": 1, "max_concurrency": 2, "max_retries": 6 }]
  },
  "triggers": { "crons": ["17 9 * * *"] },
  "limits": { "cpu_ms": 120000 },
  "vars": {
    "OAUTH_ISSUER": "https://auth.example.com",
    "OAUTH_AUTH_SERVER": "https://accounts.example.com",
    "ALLOWED_ORG_ID": "<allowed-org-id>",
    "OAUTH_VERIFIER_KEY": "<RS256 public key (SPKI PEM) of the token issuer>"
  },
  "observability": { "enabled": true }
}
